{
	"name": "data-office-forms",
	"version": "0.1.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "next build",
		"check": "oxlint && oxfmt --check",
		"check:unsafe": "oxlint --fix --fix-suggestions --fix-dangerously && oxfmt",
		"check:write": "oxlint --fix && oxfmt",
		"format": "oxfmt",
		"lint": "oxlint",
		"db:generate": "prisma migrate dev",
		"db:migrate": "prisma migrate deploy",
		"db:push": "prisma db push",
		"db:studio": "prisma studio",
		"dev": "next dev",
		"postinstall": "prisma generate",
		"preview": "next build && next start",
		"start": "next start",
		"typecheck": "tsc --noEmit",
		"predev": "react-dsfr update-icons",
		"prebuild": "react-dsfr update-icons"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.779.0",
		"@aws-sdk/s3-request-presigner": "3.779.0",
		"@codegouvfr/react-dsfr": "^1.26.0",
		"@emotion/react": "^11.14.0",
		"@emotion/server": "^11.11.0",
		"@emotion/styled": "^11.14.0",
		"@mui/material": "^7.0.1",
		"@prisma/client": "^6.16.2",
		"@t3-oss/env-nextjs": "^0.12.0",
		"@tanstack/react-form": "^1.27.7",
		"@tanstack/react-query": "^5.69.0",
		"@tanstack/react-table": "^8.21.2",
		"@trpc/client": "^11.0.0",
		"@trpc/next": "^11.0.0",
		"@trpc/react-query": "^11.0.0",
		"@trpc/server": "^11.0.0",
		"better-auth": "^1.3.9",
		"docxtemplater": "^3.68.7",
		"grist-js": "^0.0.1",
		"js-cookie": "^3.0.5",
		"jwt-decode": "^4.0.0",
		"next": "^16.2.6",
		"pizzip": "^3.2.0",
		"react": "^19.0.0",
		"react-dom": "^19.0.0",
		"sonner": "^2.0.3",
		"superjson": "^2.2.1",
		"superjson-next": "0.8.5",
		"trpc-to-openapi": "^3.1.0",
		"tss-react": "^4.9.16",
		"usehooks-ts": "^3.1.1",
		"yaml": "^2.7.1",
		"zod": "^4.3.6",
		"zod-openapi": "^5.4.6"
	},
	"devDependencies": {
		"@types/js-cookie": "^3.0.6",
		"@types/node": "^20.14.10",
		"@types/react": "^19.0.0",
		"@types/react-dom": "^19.0.0",
		"lefthook": "^1.11.13",
		"oxfmt": "^0.51.0",
		"oxlint": "^1.66.0",
		"prisma": "^6.16.2",
		"typescript": "^5.8.2",
		"zod-schema-faker": "^2.0.0-beta.2"
	},
	"packageManager": "yarn@1.22.18",
	"ct3aMetadata": {
		"initVersion": "7.39.0"
	},
	"prisma": {
		"seed": "npx tsx prisma/seed/main.ts"
	}
